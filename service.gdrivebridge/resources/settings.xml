<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.gdrivebridge">
    <category id="account" label="30010">
      <group id="1">
        <setting id="open_setup" type="action" label="30014" help="30015">
          <level>0</level>
          <data>RunScript(service.gdrivebridge,setup)</data>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="action"><close>true</close></control>
        </setting>
        <setting id="client_id" type="string" label="30011" help="30012">
          <level>0</level>
          <default/>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30011</heading></control>
        </setting>
        <setting id="client_secret" type="string" label="30013" help="30012">
          <level>0</level>
          <default/>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30013</heading><hidden>true</hidden></control>
        </setting>
        <setting id="relay_url" type="string" label="30048" help="30049">
          <level>0</level>
          <default/>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30048</heading></control>
        </setting>
        <setting id="sign_out" type="action" label="30016">
          <level>0</level>
          <data>RunScript(service.gdrivebridge,signout)</data>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="action"><close>true</close></control>
        </setting>
      </group>
    </category>
    <category id="drive" label="30020">
      <group id="1">
        <setting id="show_shared" type="boolean" label="30021">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_drives" type="boolean" label="30022">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="hide_dot" type="boolean" label="30050" help="30051">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_starred" type="boolean" label="30054" help="30055">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="heic_as_jpeg" type="boolean" label="30056" help="30057">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="hide_archives" type="boolean" label="30052" help="30053">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="poll_interval" type="integer" label="30023">
          <level>0</level>
          <default>60</default>
          <constraints><minimum>15</minimum><step>15</step><maximum>3600</maximum></constraints>
          <control type="edit" format="integer"><heading>30023</heading></control>
        </setting>
      </group>
    </category>
    <category id="network" label="30030">
      <group id="1" label="30042">
        <setting id="webdav_port" type="integer" label="30031">
          <level>0</level>
          <default>8765</default>
          <constraints><minimum>1024</minimum><step>1</step><maximum>65535</maximum></constraints>
          <control type="edit" format="integer"><heading>30031</heading></control>
        </setting>
        <setting id="lan_share" type="boolean" label="30032" help="30043">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="lan_user" type="string" label="30033">
          <level>0</level>
          <default>kodi</default>
          <dependencies><dependency type="enable" setting="lan_share">true</dependency></dependencies>
          <control type="edit" format="string"><heading>30033</heading></control>
        </setting>
        <setting id="lan_password" type="string" label="30034">
          <level>0</level>
          <default/>
          <constraints><allowempty>true</allowempty></constraints>
          <dependencies><dependency type="enable" setting="lan_share">true</dependency></dependencies>
          <control type="edit" format="string"><heading>30034</heading><hidden>true</hidden></control>
        </setting>
      </group>
      <group id="2" label="30044">
        <setting id="setup_mode" type="integer" label="30035">
          <level>0</level>
          <default>1</default>
          <constraints>
            <options>
              <option label="30036">0</option>
              <option label="30037">1</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="setup_port" type="integer" label="30038">
          <level>0</level>
          <default>8766</default>
          <constraints><minimum>1024</minimum><step>1</step><maximum>65535</maximum></constraints>
          <control type="edit" format="integer"><heading>30038</heading></control>
        </setting>
        <setting id="lan_address_detected" type="string" label="30060" help="30061">
          <level>0</level>
          <default/>
          <enable>false</enable>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30060</heading></control>
        </setting>
        <setting id="lan_address" type="string" label="30046" help="30047">
          <level>0</level>
          <default/>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="ip"><heading>30046</heading></control>
        </setting>
      </group>
    </category>
    <category id="advanced" label="30040">
      <group id="1">
        <setting id="debug" type="boolean" label="30041">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
